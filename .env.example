# Copy to .env (git-ignored) and fill in. Passed to the build with
#   --dart-define-from-file=.env   (scripts/build-apk.ps1 does this).
# Nothing here is a server secret: these values ship inside the app.

# Supabase project (free tier): Dashboard > Project Settings > API Keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional push (Firebase Cloud Messaging, free). Leave empty to build without
# push: messages still arrive over Realtime while the app runs and on launch.
# Firebase console > Project settings > General > Your apps (Android app
# app.bvm.messenger) and > Cloud Messaging.
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
