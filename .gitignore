# ---- Project-local toolchain (JDK, Flutter, Android SDK, Rust, caches) ----
/.toolchain/

# ---- Secrets: never commit ----
.env
.env.*
!.env.example
/.secrets/
*.jks
*.keystore
android/key.properties
google-services.json
GoogleService-Info.plist
supabase/.env
supabase/.temp/
